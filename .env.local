# Local machine settings (git-ignored). Restart `npx expo start` after editing.

# Base URL of OSP-LIFEPLAN-OPERATION-API, including /api.
#
# Android (emulator or USB device): "localhost" is the device itself, so forward
# the port to this PC first — re-run after every reconnect / emulator restart:
#   adb reverse tcp:5221 tcp:5221
# and run the API with its "http" launch profile. Under the "https" profile,
# http://…:5221 is 307-redirected to https://…:7010, whose dev certificate
# Android does not trust → "Network request failed".
#
# Web / iOS simulator on this PC can use https://localhost:7010/api instead.
#Tunnel URL for testing on mobile devices without port forwarding. Use the "https" launch profile of the API.
EXPO_PUBLIC_API_URL=https://33r2k38g-5001.asse.devtunnels.ms/api
# EXPO_PUBLIC_API_URL=http://192.168.10.164:5221/api

# Base URL of OSP-SYNC-WORKER-API, including /api ("https" launch profile).
# Every data write (incl. sign-up) goes here via tblSyncOutbox → POST /sync/inbox.
# Web / iOS simulator on this PC reach localhost directly. Android: localhost is
# the device itself — run `adb reverse tcp:7249 tcp:7249`, and note Android does
# not trust the dev certificate; use http://localhost:5163/api (adb reverse
# tcp:5163 tcp:5163) or a dev tunnel there instead.
#EXPO_PUBLIC_SYNC_WORKER_URL=https://7bwsw6hj-7249.asse.devtunnels.ms/api
# EXPO_PUBLIC_SYNC_WORKER_URL=https://localhost:7249/api
EXPO_PUBLIC_SYNC_WORKER_URL=https://7bwsw6hj-7249.asse.devtunnels.ms/api
# Push/pull through the sync worker. false keeps every change queued on the device.
EXPO_PUBLIC_SYNC_ENABLED=true
# API Key for the sync worker. The sync worker rejects requests without this key.
EXPO_PUBLIC_SYNC_API_KEY=1eFXL8TTfQ2FgkHHonPp-zSgFbsZeZRATk5AIVsCB9Y
